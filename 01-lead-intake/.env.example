# Project 1 - Lead intake. These are n8n credentials and IDs, listed so nothing is missed on a fresh instance.
HUBSPOT_SERVICE_KEY=          # HubSpot service key, scopes crm.objects.contacts.read/write, crm.objects.deals.read/write
HUBSPOT_PORTAL_ID=
HUBSPOT_DEAL_STAGE_NEW=       # stage id of "New" in the default pipeline
SLACK_BOT_TOKEN=              # xoxb- token, bot invited to #leads and #automation-alerts
SLACK_LEADS_CHANNEL_ID=
GMAIL_OAUTH_CLIENT_ID=        # Google Cloud OAuth client for the Gmail trigger and Sheets
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_LEADS_LABEL_ID=         # id of the leads/inbound label
LEAD_LOG_SHEET_ID=            # Google Sheet with a "Leads" tab
ANTHROPIC_API_KEY=            # used by the n8n Anthropic node and by enrich/enrich.py
