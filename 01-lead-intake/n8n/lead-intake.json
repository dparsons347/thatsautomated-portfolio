    {
      "name": "HubSpot test hook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const lead = $('Not disposable').item.json;\nconst forced = Number(lead.simulate_429 || 0);\nif ($runIndex < forced) {\n  throw new Error(`HubSpot returned 429 Too Many Requests (simulated by test hook, forced failure ${$runIndex + 1} of ${forced})`);\n}\nreturn { json: lead };"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Plan retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        608
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const lead = $('Not disposable').item.json;\nconst attempt = $runIndex + 1;\nconst err = String($json.error?.message ?? $json.error ?? JSON.stringify($json)).slice(0, 300);\nreturn { json: {\n  attempt,\n  retry: attempt < 4,\n  wait_s: 2 ** attempt,\n  error: err,\n  email: lead.email, name: lead.name, company: lead.company, phone: lead.phone,\n  message: lead.message, source_label: lead.source_label, received_at: lead.received_at\n} };"
      }
