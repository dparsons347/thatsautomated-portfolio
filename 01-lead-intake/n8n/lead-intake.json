    {
      "name": "Basic checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const j = { ...$json };\nconst email = String(j.email || '').trim().toLowerCase();\nconst name = String(j.name || '').trim();\nconst reasons = [];\nif (j.reject_reason) reasons.push(j.reject_reason);\nif (!email) reasons.push('missing email');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) reasons.push('invalid email');\nif (!name) reasons.push('missing name');\nconst text = `${j.message || ''} ${j.company || ''}`;\nif (/\\b(seo|backlinks?|guest post|crypto|bitcoin|casino|viagra|forex)\\b/i.test(text)) reasons.push('spam keywords');\nif ((text.match(/https?:\\/\\//g) || []).length > 3) reasons.push('too many links');\nconst parts = name.split(/\\s+/);\nreturn { json: { ...j, email, name, domain: email.includes('@') ? email.split('@')[1] : '', first_name: parts[0] || '', last_name: parts.slice(1).join(' '), reject_reason: [...new Set(reasons)].join('; ') } };"
      }
    },
