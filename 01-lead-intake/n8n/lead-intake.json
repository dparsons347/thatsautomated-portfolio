    {
      "name": "Extract lead with Claude",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        224,
        80
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "claude-haiku-4-5-20251001",
          "cachedResultName": "claude-haiku-4-5-20251001"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Sender name: {{ $json.from?.value?.[0]?.name ?? \"\" }}\nSender email: {{ $json.from?.value?.[0]?.address ?? \"\" }}\nSubject: {{ $json.subject ?? \"\" }}\n\nBody:\n{{ ($json.text ?? \"\").slice(0, 6000) }}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "system": "You read emails that arrive in a small service business's leads inbox and pull out the prospective customer's details. The email may be written by the customer directly or be a forwarded notification from a lead service such as Angi, Thumbtack, HomeAdvisor, or a referral partner. In a forwarded notification, the customer is the person described inside the notification, not the sender of the email.\n\nReturn ONLY a JSON object, no prose, no code fences, with exactly these keys:\n{\"is_lead\": true|false, \"reject_reason\": string, \"name\": string, \"email\": string, \"phone\": string, \"company\": string, \"message\": string}\n\nRules:\n- is_lead is false for newsletters, marketing, vendor pitches, SEO or link-building offers, receipts, automated notices that contain no customer request, and spam. Put a short reason in reject_reason. Otherwise reject_reason is \"\".\n- Use only information present in the email. Never invent a phone number, company, or email. Use \"\" when a value is not present.\n- email: the customer's email address. If the customer wrote directly, use the sender email.\n- company: the customer's business name if they give one, else \"\".\n- message: one or two sentences describing what the customer wants, in plain words.",
          "maxTokens": 512,
          "temperature": 0
        }
      },
      "credentials": {
        "anthropicApi": {
          "name": "Anthropic account"
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "name": "Normalize email lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        80
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const src = $('Leads inbox').item.json;\nconst sender = src.from?.value?.[0] ?? {};\nlet raw = '';\nconst c = $json.content;\nif (typeof c === 'string') raw = c;\nelse if (Array.isArray(c)) raw = c.map(p => p.text ?? '').join('');\nelse raw = $json.text ?? $json.output ?? $json.message?.content ?? '';\nlet parsed = {};\nlet parseError = '';\ntry {\n  const s = raw.indexOf('{'); const e = raw.lastIndexOf('}');\n  parsed = JSON.parse(raw.slice(s, e + 1));\n} catch (err) { parseError = 'could not parse Claude output'; }\nconst isLead = parsed.is_lead !== false && !parseError;\nreturn { json: {\n  name: parsed.name || sender.name || '',\n  email: parsed.email || sender.address || '',\n  phone: parsed.phone || '',\n  company: parsed.company || '',\n  message: parsed.message || src.subject || '',\n  source: 'Email',\n  source_label: 'Email',\n  reject_reason: isLead ? '' : ('not a lead: ' + (parsed.reject_reason || parseError || 'no reason given')),\n  received_at: $now.toISO(),\n  gmail_id: src.id ?? ''\n} };"
      }
    },
