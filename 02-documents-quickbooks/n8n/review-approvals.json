              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "name": "Read review sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        224,
        200
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "authentication": "oAuth2",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_REVIEW_SHEET_ID",
          "cachedResultName": "P2 AP review queue"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Review queue"
        },
        "options": {}
      },
