# Copy to deploy/.env on the server. Never commit the real file.

# Shared secret n8n sends as the X-Webhook-Key header (n8n Header Auth credential).
TRIAGE_API_KEY=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Outage demo: set to https://dead.invalid, then docker compose up -d triage-api
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_SECONDS=30

# Default gate. n8n can override per request (the "threshold" field).
CONFIDENCE_THRESHOLD=0.75

# HubSpot private app / service key with crm.objects.contacts.read and crm.objects.deals.read
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=247523905

# Slack app > Basic Information > Signing Secret (used by POST /slack/verify)
SLACK_SIGNING_SECRET=

BOOKING_URL=https://thatsautomated.com/contact

# LangSmith tracing (smith.langchain.com > Settings > API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=p6-support-triage
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
