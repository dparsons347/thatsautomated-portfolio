    {
      "id": "d448a61e-3d0f-4b1b-9216-47e9b684d1c8",
      "name": "Queue for retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst row = $('Get message').first().json;\nconst e = $json.error || $json;\nlet msg = typeof e === 'string' ? e : [e.message, e.description].filter(Boolean).join(' ');\nmsg = (msg || 'unknown error').slice(0, 400);\nconst attempts = (Number(row.attempts) || 0) + 1;\nconst failed = attempts >= 7;\nreturn [{ json: { message_id: row.message_id, attempts, status: failed ? 'failed' : 'queued', last_error: msg,\n  notify: attempts === 1 || failed, failed, subject: row.subject || '', from: row.from_email } }];\n"
      }
    },
