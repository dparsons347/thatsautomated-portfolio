        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "1d143390-30da-4546-b092-970a3e02d7fa",
      "name": "Build card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst s = $('Settings').first().json;\nconst row = $('Get message').first().json;\nconst r = $input.first().json;\nconst trunc = (t, n) => { t = t || ''; return t.length > n ? t.slice(0, n - 1) + '\u2026' : t; };\nconst esc = t => String(t || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst quote = t => esc(t).split('\\n').map(l => '>' + l).join('\\n');\nconst catLabel = { sales: 'Sales', support: 'Support', existing_client: 'Existing client', vendor: 'Vendor', spam: 'Spam', unclear: 'Unclear' }[r.category] || r.category;\nconst catEmoji = { sales: ':moneybag:', support: ':wrench:', existing_client: ':handshake:', vendor: ':package:', spam: ':no_entry_sign:', unclear: ':grey_question:' }[r.category] || ':email:';\nconst routeLabel = { draft: ':white_check_mark: Draft ready for review', person: ':raising_hand: Needs a person', archive: ':file_cabinet: Suggest archive' }[r.route] || r.route;\n\nlet cust;\nif (r.lookup_error) {\n  cust = ':warning: HubSpot lookup failed (' + esc(r.lookup_error) + '). Treated as a new sender.';\n} else if (r.customer) {\n  const c = r.customer;\n  const deals = (c.deals || []).slice(0, 3).map(d => esc(d.name) + ' (' + esc(d.stage) + (d.amount ? ', $' + Number(d.amount).toLocaleString('en-US') : '') + ')').join(' \u00b7 ');\n  cust = '*' + esc(c.name || c.email) + '*' + (c.company ? ', ' + esc(c.company) : '') + ' \u00b7 ' + esc(c.lifecycle_stage || 'contact')\n    + (deals ? '\\n' + deals : '\\nNo deals') + (c.url ? '\\n<' + c.url + '|Open in HubSpot>' : '');\n} else {\n  cust = 'Not in HubSpot (new sender)';\n}\n\nconst blockId = 'p6|' + row.message_id;\nconst btn = (id, text, style) => { const b = { type: 'button', action_id: id, text: { type: 'plain_text', text }, value: row.message_id }; if (style) b.style = style; return b; };\nconst reassign = { type: 'users_select', action_id: 'reassign', placeholder: { type: 'plain_text', text: 'Reassign to\u2026' } };\nlet actions;\nif (r.route === 'draft') actions = [btn('approve', 'Approve and send', 'primary'), btn('edit', 'Edit'), reassign, btn('archive', 'Archive')];\nelse if (r.route === 'archive') actions = [btn('archive', 'Archive', 'primary'), btn('edit', 'Write reply'), reassign];\nelse actions = [btn('edit', r.draft ? 'Edit and send' : 'Write reply', 'primary'), reassign, btn('archive', 'Archive')];\n\nconst blocks = [\n  { type: 'header', text: { type: 'plain_text', emoji: true, text: trunc(catEmoji + ' ' + catLabel + ' \u00b7 ' + Math.round(r.confidence * 100) + '% \u00b7 ' + (row.from_name || row.from_email), 150) } },\n  { type: 'section', text: { type: 'mrkdwn', text: '*From:* ' + esc(row.from_name) + ' <mailto:' + row.from_email + '|' + row.from_email + '>\\n*Subject:* ' + esc(row.subject)\n      + (r.is_reply ? '\\n:repeat: Reply on an open thread' : '') } },\n  { type: 'section', fields: [ { type: 'mrkdwn', text: '*Route*\\n' + routeLabel }, { type: 'mrkdwn', text: '*Why this category*\\n' + esc(trunc(r.reason, 280)) } ] },\n];\nif ((r.gate_reasons || []).length) blocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*Sent to a person because*\\n' + r.gate_reasons.map(g => '\u2022 ' + esc(g)).join('\\n') } });\nblocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*Customer*\\n' + cust } });\nblocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*Message*\\n' + quote(trunc(row.body, 900)) } });\nif (r.draft) blocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*Draft reply*\\n' + quote(trunc(r.draft, 2500)) } });\nblocks.push({ type: 'actions', block_id: blockId, elements: actions });\nblocks.push({ type: 'context', elements: [ { type: 'mrkdwn', text: 'Threshold ' + r.threshold + ' \u00b7 ' + (r.trace_url ? '<' + r.trace_url + '|LangSmith trace>' : 'tracing off') + ' \u00b7 nothing is sent without a click' } ] });\n\nreturn [{ json: {\n  recovered: row.status === 'queued', attempts: Number(row.attempts) || 0,\n  row: {\n    message_id: row.message_id, status: 'awaiting_review', last_error: '',\n    category: r.category, confidence: r.confidence, reason: r.reason, route: r.route,\n    needs_human: r.needs_human, gate_reasons: (r.gate_reasons || []).join('\\n'), draft: r.draft || '',\n    customer_json: r.customer ? JSON.stringify(r.customer) : (r.lookup_error ? JSON.stringify({ lookup_error: r.lookup_error }) : ''),\n    trace_url: r.trace_url || '',\n  },\n  slack: { channel: s.triage_channel, text: catLabel + ': ' + (row.subject || '(no subject)'), unfurl_links: false, unfurl_media: false, blocks },\n} }];\n"
      }
    },
