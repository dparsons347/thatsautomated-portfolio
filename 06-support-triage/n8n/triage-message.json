    {
      "id": "7f3253d0-f6fb-4af4-885d-a9900046e9a6",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst s = $('Settings').first().json;\nconst row = $('Get message').first().json;\nconst all = $input.all().map(i => i.json);\nconst others = all.filter(r => r.message_id !== row.message_id && String(r.received_at || '') <= String(row.received_at || '9999'));\nothers.sort((a, b) => String(a.received_at).localeCompare(String(b.received_at)));\nconst history = others.slice(-8).map(r => ({\n  from_email: r.from_email || '', body: String(r.body || '').slice(0, 1500),\n  category: r.direction === 'outbound' ? null : (r.category || null),\n  direction: r.direction === 'outbound' ? 'outbound' : 'inbound',\n}));\nconst priorIn = others.filter(r => r.direction !== 'outbound' && r.category).pop();\nreturn [{ json: { request: {\n  message_id: row.message_id, thread_id: row.thread_id, from_email: row.from_email, from_name: row.from_name || '',\n  subject: row.subject || '', body: row.body || '(empty body)', thread_history: history,\n  prior_category: priorIn ? priorIn.category : null, threshold: Number(s.threshold),\n} } }];\n"
      }
    },
    {
      "id": "d6e3fcfa-87ba-44a8-9f25-a836a1b6c651",
      "name": "Call triage service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.service_url }}/triage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 90000
