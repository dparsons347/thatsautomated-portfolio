    {
      "id": "2f34d178-0669-4375-8112-7c8d1c507239",
      "name": "Read raw body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst item = $input.first();\nlet raw = '';\nif (item.binary && item.binary.data) {\n  try {\n    const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n    raw = buf.toString('utf8');\n  } catch (e) {\n    raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n  }\n}\nconst h = item.json.headers || {};\nreturn [{ json: { timestamp: String(h['x-slack-request-timestamp'] || ''), signature: String(h['x-slack-signature'] || ''), body: raw } }];\n"
      }
    },
    {
      "id": "b781d51b-8ce5-4379-9fa0-0ceb55e7888e",
