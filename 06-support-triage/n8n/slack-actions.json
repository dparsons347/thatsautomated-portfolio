    {
      "id": "0935f4d1-b8af-4933-90dc-1294c6467bbc",
      "name": "Build email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst d = $('Decide').first().json;\nconst row = d.row;\nconst text = String(d.action === 'approve' ? (row.draft || '') : (d.text || '')).trim();\nif (!text) throw new Error('Nothing to send: the reply is empty');\nconst subj = /^re:/i.test(row.subject || '') ? row.subject : 'Re: ' + (row.subject || '');\nconst b64 = s => Buffer.from(s, 'utf8').toString('base64');\nconst name = String(row.from_name || '').replace(/[\"\\r\\n]/g, '');\nconst refs = [row.references_hdr, row.rfc_message_id].filter(Boolean).join(' ');\nconst headers = [\n  'From: \"Daniel Parsons\" <daniel@thatsautomated.com>',\n  'To: ' + (name ? '\"' + name + '\" ' : '') + '<' + row.from_email + '>',\n  'Reply-To: daniel+support@thatsautomated.com',\n  'Subject: =?UTF-8?B?' + b64(subj) + '?=',\n  row.rfc_message_id ? 'In-Reply-To: ' + row.rfc_message_id : '',\n  refs ? 'References: ' + refs : '',\n  'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=UTF-8',\n  'Content-Transfer-Encoding: base64',\n].filter(Boolean);\nconst body = b64(text.replace(/\\r?\\n/g, '\\r\\n')).replace(/(.{76})/g, '$1\\r\\n');\nconst mime = headers.join('\\r\\n') + '\\r\\n\\r\\n' + body;\nconst raw = b64(mime).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\nreturn [{ json: { raw, threadId: row.thread_id, text } }];\n"
      }
    },
