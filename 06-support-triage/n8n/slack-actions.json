    {
      "id": "235d9097-4ece-41dd-8382-ac3bc73b5ffd",
      "name": "Resolved card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3340,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst a = $('Decide').first().json;\nconst row = a.row;\nlet sent = '';\ntry { sent = $('Build email').first().json.text; } catch (e) {}\nconst esc = t => String(t || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst quote = t => esc(t).split('\\n').map(l => '>' + l).join('\\n');\nconst when = new Date().toLocaleString('en-US', { timeZone: 'America/Chicago', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\nconst outcome = {\n  approve: ':white_check_mark: Sent as drafted by <@' + a.user + '>',\n  send_edited: ':pencil2: Edited and sent by <@' + a.user + '>',\n  reassign: ':bust_in_silhouette: Routed to <@' + a.selected_user + '> by <@' + a.user + '>',\n  archive: ':file_cabinet: Archived by <@' + a.user + '>',\n}[a.action] || 'Handled';\nconst cat = { sales: 'Sales', support: 'Support', existing_client: 'Existing client', vendor: 'Vendor', spam: 'Spam', unclear: 'Unclear' }[row.category] || row.category;\nconst blocks = [\n  { type: 'section', text: { type: 'mrkdwn', text: '*' + cat + ' \u00b7 ' + Math.round(Number(row.confidence) * 100) + '%* \u00b7 ' + esc(row.from_name || row.from_email) + ' <mailto:' + row.from_email + '|' + row.from_email + '>\\n*Subject:* ' + esc(row.subject) } },\n  { type: 'section', text: { type: 'mrkdwn', text: outcome + ' \u00b7 ' + when } },\n];\nif (sent) blocks.push({ type: 'section', text: { type: 'mrkdwn', text: '*Sent*\\n' + quote(sent.slice(0, 2500)) } });\nblocks.push({ type: 'context', elements: [{ type: 'mrkdwn', text: esc(row.reason || '') + (row.trace_url ? ' \u00b7 <' + row.trace_url + '|LangSmith trace>' : '') }] });\nreturn [{ json: { channel: a.channel, ts: a.ts, text: outcome, blocks } }];\n"
      }
    },
    {
      "id": "6193505c-8889-4379-82b3-cb4e1684d622",
