        "jsCode": "\nconst d = $('Decide').first().json;\nconst row = d.row;\nconst input = { type: 'plain_text_input', action_id: 'reply_text', multiline: true };\nif (row.draft) input.initial_value = String(row.draft).slice(0, 2900);\nreturn [{ json: { trigger_id: d.trigger_id, view: {\n  type: 'modal', callback_id: 'p6_edit',\n  private_metadata: JSON.stringify({ message_id: d.message_id, channel: d.channel, ts: d.ts }),\n  title: { type: 'plain_text', text: 'Reply to sender' },\n  submit: { type: 'plain_text', text: 'Send' },\n  close: { type: 'plain_text', text: 'Cancel' },\n  blocks: [\n    { type: 'context', elements: [{ type: 'mrkdwn', text: 'To: ' + row.from_email + '\\nRe: ' + (row.subject || '') }] },\n    { type: 'input', block_id: 'reply_block', label: { type: 'plain_text', text: 'Reply' }, element: input },\n    { type: 'context', elements: [{ type: 'mrkdwn', text: 'Sends from daniel@thatsautomated.com on the same Gmail thread.' }] },\n  ],\n} } }];\n"
      }
    },
