    {
      "id": "03de8766-0798-434c-88d0-494a7893950d",
      "name": "Parse action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst raw = $('Read raw body').first().json.body;\nlet payloadStr = '';\ntry { payloadStr = new URLSearchParams(raw).get('payload') || ''; } catch (e) {}\nif (!payloadStr) payloadStr = (($('Slack action').first().json.body) || {}).payload || '';\nconst p = JSON.parse(payloadStr);\nconst out = { type: p.type, user: (p.user || {}).id || '', action: 'ignore', message_id: '', channel: '', ts: '',\n  trigger_id: p.trigger_id || '', selected_user: '', text: '' };\nif (p.type === 'block_actions' && p.actions && p.actions[0]) {\n  const a = p.actions[0];\n  const bid = String(a.block_id || '');\n  if (bid.startsWith('p6|')) { out.message_id = bid.slice(3); out.action = a.action_id; out.selected_user = a.selected_user || ''; }\n  out.channel = (p.container || {}).channel_id || (p.channel || {}).id || '';\n  out.ts = (p.container || {}).message_ts || '';\n} else if (p.type === 'view_submission' && p.view && p.view.callback_id === 'p6_edit') {\n  const meta = JSON.parse(p.view.private_metadata || '{}');\n  out.action = 'send_edited';\n  out.message_id = meta.message_id || ''; out.channel = meta.channel || ''; out.ts = meta.ts || '';\n  const v = (((p.view.state || {}).values || {}).reply_block || {}).reply_text || {};\n  out.text = v.value || '';\n}\nreturn [{ json: out }];\n"
      }
    },
