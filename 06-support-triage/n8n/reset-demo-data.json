    {
      "id": "4179261f-1947-4e28-aef2-85ee06609047",
      "name": "Thread replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        680,
        620
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://slack.com/api/conversations.replies?channel=C0C68M157CG&ts={{ $json.ts }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi"
      },
