    {
      "id": "bc35a851-e3d4-46da-aa8d-618d60d9b6f1",
      "name": "Everything the bot posted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  for (const m of (item.json.messages || [])) {\n    if (m.bot_id === 'B0C16E9LRU6' && !seen.has(m.ts)) { seen.add(m.ts); out.push({ json: { ts: m.ts } }); }\n  }\n}\n// replies first, parents last, so no \"message deleted\" placeholders are left behind\nout.sort((a, b) => Number(b.json.ts) - Number(a.json.ts));\nreturn out;\n"
      }
    },
    {
      "id": "4f0600c2-90aa-4ffb-9695-31f83bfb797e",
