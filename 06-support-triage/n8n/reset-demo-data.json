      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst msgs = ($input.first().json.messages || []);\nreturn msgs.filter(m => m.bot_id === 'B0C16E9LRU6').map(m => ({ json: { ts: m.ts } }));\n"
      }
