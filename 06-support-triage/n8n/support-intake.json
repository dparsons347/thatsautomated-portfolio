    {
      "id": "06a53cf6-18c7-4ebc-abed-fe9a2b6d2e20",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst m = $json;\nconst fromV = (m.from && m.from.value && m.from.value[0]) || {};\nconst from_email = String(fromV.address || '').toLowerCase();\n// Keep only the new text: drop quoted lines and everything after an \"On ... wrote:\" marker.\nconst lines = String(m.text || '').replace(/\\r/g, '').split('\\n');\nconst out = [];\nfor (let i = 0; i < lines.length; i++) {\n  const l = lines[i].trim();\n  const joined = (l + ' ' + ((lines[i + 1] || '').trim())).trim();\n  if ((/^On .*wrote:$/.test(l)) || (/^On /.test(l) && /wrote:$/.test(joined)) || /^-{2,}\\s*Original Message/i.test(l)) break;\n  if (l.startsWith('>')) continue;\n  out.push(lines[i]);\n}\nlet refs = m.references;\nif (Array.isArray(refs)) refs = refs.join(' ');\nreturn { json: {\n  message_id: m.id, thread_id: m.threadId, rfc_message_id: m.messageId || '', references_hdr: refs || '',\n  from_email, from_name: fromV.name || '', subject: m.subject || '',\n  body: out.join('\\n').trim().slice(0, 6000),\n  received_at: m.date ? new Date(m.date).toISOString() : new Date().toISOString(),\n  is_self: from_email === 'daniel@thatsautomated.com',\n} };\n"
      }
    },
