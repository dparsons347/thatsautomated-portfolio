# Copy to deploy/.env on the server. Never commit the real one.

ORDERS_HOST=orders.thatsautomated.com
TRAEFIK_NETWORK=root_default
CERT_RESOLVER=mytlschallenge
POSTGRES_PASSWORD=

# One entry per Shopify store. secret = the signing key shown under
# Settings > Notifications > Webhooks in that store's admin (or the app's client secret).
SHOPIFY_STORES=[{"code":"shopify_a","name":"Store A","shop_domain":"store-a.myshopify.com","secret":""},{"code":"shopify_b","name":"Store B","shop_domain":"store-b.myshopify.com","secret":""}]

# Stripe: Developers > Webhooks > the endpoint's signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
WHOLESALE_NAME=Wholesale

# n8n notification workflow and the header key it checks.
N8N_NOTIFY_URL=https://n8n.danielparsons.io/webhook/p3-order-notifications
N8N_NOTIFY_KEY=

# Bearer token for /admin/sweep and /admin/dispatch.
ADMIN_TOKEN=

# A paid order with no fulfillment after this long is stuck. Use 5 for the Loom, 1440 for real.
STUCK_AFTER_MINUTES=1440
SWEEP_EVERY_SECONDS=900
DISPATCH_EVERY_SECONDS=30
DISPATCH_MAX_ATTEMPTS=10
