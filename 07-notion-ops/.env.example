# Intake to Notion / Status Sync / Weekly Digest
# All of these are n8n credentials, not env vars, but listed so nothing is forgotten on a fresh instance.
NOTION_TOKEN=                # Notion personal access token or internal integration secret
NOTION_CLIENTS_DS_ID=        # Clients data source id
NOTION_PROJECTS_DS_ID=       # Projects data source id
NOTION_TASKS_DS_ID=          # Tasks data source id
SLACK_BOT_TOKEN=             # xoxb- token, bot invited to #leads and #automation-alerts
GHL_PRIVATE_INTEGRATION_TOKEN=   # pit- token, scopes opportunities.readonly + opportunities.write
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_NEW_LEAD=
GHL_STAGE_CONTACTED=
GHL_STAGE_BOOKED=
GHL_STAGE_JOB_DONE=
OWNER_EMAIL=                 # where site-form leads are emailed
